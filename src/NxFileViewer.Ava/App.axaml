<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NxFileViewer.Ava.ViewModels"
             x:Class="NxFileViewer.Ava.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <FontFamily x:Key="UbuntuMono">avares://NxFileViewer.Ava/Assets/Fonts/UbuntuMono/#Ubuntu Mono</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemChromeHighColor">#FFACACAC</Color>
                    <Color x:Key="SystemChromeLowColor">Transparent</Color>
                    <Color x:Key="SystemChromeMediumColor">#FFF2F2F2</Color>
                    <Color x:Key="SystemChromeMediumLowColor">#FFE6E6E6</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemChromeHighColor">#FF737373</Color>
                    <Color x:Key="SystemChromeLowColor">Transparent</Color>
                    <Color x:Key="SystemChromeMediumColor">#FF2B2B2B</Color>
                    <Color x:Key="SystemChromeMediumLowColor">#FF1F1F1F</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Settings" Gesture="Meta+,"
                            Click="SettingsMenu_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>
    
    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferUserAccentColor="True"
                                     PreferSystemTheme="True" />
        <StyleInclude Source="avares://ConfigFactory.Avalonia/Themes/Fluent/ConfigFactory.Avalonia.axaml" />
    </Application.Styles>
</Application>